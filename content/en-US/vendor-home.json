ass=\"dropdown\">\n<a class=\"dropdown-toggle\" data-toggle=\"dropdown\" title=\"Vendors\" href=\"javascript:;\">Vendors\n<b class=\"caret\"></b>\n</a><ul class=\"dropdown-menu dropdown-menu-caret dropdown-menu-lg\"><li><ul class=\"two-col\">\n<li class=\"\">\n<a title=\"קייטרינג\" href=\"/he-IL/directory/search/categories/8-קייטרינג\"><i class=\"ip-icon-cook-hat\"></i>\nקייטרינג\n</a></li>\n<li class=\"\">\n<a title=\"שירותי בר\" href=\"/he-IL/directory/search/categories/25-שירותי-בר\"><i class=\"ip-icon-cocktail\"></i>\nשירותי בר\n</a></li>\n<li class=\"\">\n<a title=\"עיצוב\" href=\"/he-IL/directory/search/categories/6-עיצוב\"><i class=\"ip-icon-curtains\"></i>\nעיצוב\n</a></li>\n<li class=\"\">\n<a title=\"מוזיקה\" href=\"/he-IL/directory/search/categories/11-מוזיקה\"><i class=\"ip-icon-music\"></i>\nמוזיקה\n</a></li>\n<li class=\"\">\n<a title=\"צילום\" href=\"/he-IL/directory/search/categories/9-צילום\"><i class=\"ip-icon-camera\"></i>\nצילום\n</a></li>\n<li class=\"\">\n<a title=\"שמלות כלה וערב\" href=\"/he-IL/directory/search/categories/2-שמלות-כלה-וערב\"><i class=\"ip-icon-tailored-dress\"></i>\nשמלות כלה וערב\n</a></li>\n<li class=\"\">\n<a title=\"איפור ועיצוב שיער\" href=\"/he-IL/directory/search/categories/5-איפור-ועיצוב-שיער\"><i class=\"ip-icon-cosmetics\"></i>\nאיפור ועיצוב שיער\n</a></li>\n<li class=\"\">\n<a title=\"צילום מגנטים\" href=\"/he-IL/directory/search/categories/10-צילום-מגנטים\"><i class=\"ip-icon-pictures\"></i>\nצילום מגנטים\n</a></li>\n<li class=\"\">\n<a title=\"הזמנות ומיתוג\" href=\"/he-IL/directory/search/categories/23-הזמנות-ומיתוג-לאירוע\"><i class=\"ip-icon-wedding-invitation\"></i>\nהזמנות ומיתוג\n</a></li>\n<li class=\"\">\n<a title=\"הסעות לאורחים\" href=\"/he-IL/directory/search/categories/19-הסעות-לאורחים\"><i class=\"ip-icon-bus\"></i>\nהסעות לאורחים\n</a></li>\n<li class=\"\">\n<a title=\"תכשיטים ואקססוריז\" href=\"/he-IL/directory/search/categories/32-תכשיטים-ואקססוריז\"><i class=\"ip-icon-wedding-rings\"></i>\nתכשיטים ואקססוריז\n</a></li>\n<li class=\"\">\n<a title=\"הפקת אירוע\" href=\"/he-IL/directory/search/categories/37-הפקת-אירוע\"><i class=\"ip-icon-planner\"></i>\nהפקת אירוע\n</a></li>\n<li class=\"\">\n<a title=\"אטרקציות\" href=\"/he-IL/directory/search/categories/18-אטרקציות\"><i class=\"ip-icon-party\"></i>\nאטרקציות\n</a></li>\n<li class=\"empty\" style=\"visibility: hidden\">\n<a tabindex=\"-1\" aria-hidden=\"true\" href=\"#\"><i class=\"ip-icon-table-with-chairs\"></i>\n&nbsp;\n</a></li>\n</ul>\n</li>\n</ul>\n</li>\n<li class=\"text-search hidden-xs hidden-sm\"><a data-action=\"focus\" aria-label=\"Search\" title=\"Search\" href=\"javascript:;\"><i class=\"fas fa-search\"></i>\n</a><input type=\"text\" name=\"text-search-input\" id=\"brand-page-text-search-input-desktop\" placeholder=\"Search vendor\" aria-label=\"Search vendor\" dir=\"ltr\" autocomplete=\"off\" autocorrect=\"off\" autocapitalize=\"off\" style=\"\">\n<a data-action=\"clear\" aria-label=\"Clear\" title=\"Clear\" href=\"javascript:;\"><i class=\"fas fa-times\"></i>\n</a></li>\n</ul>\n<ul class=\"nav navbar-nav navbar-right\">\n<li class=\"dropdown service_and_support\">\n<a href=\"/en-US/front/contact\"><div class=\"inline-block vmiddle\">Contact us</div>\n<div class=\"smaller-4\">We're here for any question</div>\n</a></li>\n<li class=\"dropdown login\">\n<a class=\"dropdown-toggle\" data-toggle=\"dropdown\" href=\"javascript:;\"><div>\nLog in\n<b class=\"caret\"></b>\n</div>\n</a><ul class=\"dropdown-menu dropdown-menu-caret columns-style\">\n<ul>\n<li>\n<a href=\"/en-US/client/sign_in\"><i class=\"ip-icon-cocktail\"></i>\nEvent owners\n</a></li>\n<li class=\"divider\"></li>\n<li>\n<a href=\"/he-IL/corp/sign_in\"><i class=\"fab fa-black-tie\"></i>\nVendors\n</a></li>\n</ul>\n</ul>\n</li>\n</ul>\n</div>\n</div>\n</nav>\n<div aria-label=\"Navigation menu\" class=\"modal\" id=\"main_navigation_modal\" role=\"dialog\" tabindex=\"-1\">\n<div class=\"modal-dialog\" role=\"document\">\n<div class=\"modal-