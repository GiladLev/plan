{"id":"vendor-marketing","title":"iPlan | Focused marketing to event venues and vendors","lang":"en","dir":"ltr","bodyClass":"ltr","html":"\n<nav class=\"navbar navbar-blue navbar-bordered navbar-fixed-top\" id=\"main_navigation\">\n<div class=\"container-fluid\">\n<!-- Brand and toggle get grouped for better mobile display -->\n<div class=\"navbar-header\">\n<button aria-label=\"Toggle navigation\" class=\"navbar-toggle collapsed\" data-modal-full-screen=\"true\" data-target=\"#main_navigation_modal\" data-toggle=\"modal\" type=\"button\">\n<span class=\"sr-only\">Toggle navigation</span>\n<span class=\"icon-bar\"></span>\n<span class=\"icon-bar\"></span>\n<span class=\"icon-bar\"></span>\n</button>\n<a class=\"navbar-brand\" title=\"iPlan\" aria-label=\"iPlan\" href=\"/en-US\"><i class=\"ip-icon-logo\"></i>\n</a><div class=\"text-search hidden-md hidden-lg\"><a data-action=\"focus\" aria-label=\"Search\" title=\"Search\" href=\"javascript:;\"><i class=\"fas fa-search\"></i>\n</a><input type=\"text\" name=\"text-search-input\" id=\"brand-page-text-search-input-mobile\" placeholder=\"Search vendor\" aria-label=\"Search vendor\" dir=\"ltr\" autocomplete=\"off\" autocorrect=\"off\" autocapitalize=\"off\" style=\"\">\n<a data-action=\"clear\" aria-label=\"Clear\" title=\"Clear\" href=\"javascript:;\"><i class=\"fas fa-times\"></i>\n</a></div>\n</div>\n<div class=\"collapse navbar-collapse\" id=\"navigation_links\">\n<ul class=\"nav navbar-nav\">\n<li class=\"dropdown active\">\n<a class=\"dropdown-toggle\" data-toggle=\"dropdown\" title=\"Planning tools\" href=\"javascript:;\">Planning tools\n<b class=\"caret\"></b>\n</a><ul class=\"dropdown-menu dropdown-menu-caret dropdown-menu-lg\"><li class=\"header text-muted\">Planning an event</li>\n<li><ul class=\"two-col\">\n<li class=\"\">\n<a title=\"What do we offer?\" href=\"/en-US/front/client/home\">What do we offer?\n</a></li>\n<li class=\"\">\n<a title=\"Guests list\" href=\"/en-US/front/client/guest_list\"><i class=\"